# APP_URL: URL nơi ứng dụng được lưu trữ (AI Studio tự động cấu hình khi chạy).
APP_URL="MY_APP_URL"

# Firebase Web Configuration (dành cho triển khai ngoài AI Studio).
# Trong môi trường AI Studio, cấu hình được đọc từ firebase-applet-config.json.
# Lưu ý: Không bao giờ đặt khóa bí mật (như GEMINI_API_KEY) vào mã nguồn frontend hoặc biến VITE_*.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_DATABASE_ID="(default)"

# Script CLI cục bộ cấp quyền admin (CHỈ chạy trên máy cá nhân, KHÔNG dùng trong frontend):
# FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/service-account.json"

# Gemini API ở backend Express (server.ts — KHÔNG dùng trong mã nguồn frontend src/):
# AI Studio tự động tiêm GEMINI_API_KEY khi chạy.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
